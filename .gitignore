# ── generated artefacts ─────────────────────────────────────────────────────
#  `results/` is regenerated by `python -m dfp.cli all`; the JSON summary is
#  tracked on purpose (the report quotes it), everything else is not.
results/*
!results/results.json
*.log
*.mp4
exports/
outputs/

# NOTE: docs/figures/ IS tracked - the README and REPORT.md embed those files.

